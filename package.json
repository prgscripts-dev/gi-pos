{
  "name": "gi-restaurant-pos",
  "private": true,
  "version": "1.1.43",
  "description": "Desktop restaurant POS system for GI POS Restaurant",
  "author": "GI Hostings",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node electron/run-electron.cjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "icon:build": "node scripts/generate-icon.cjs",
    "dist:win": "npm run icon:build && npm run build && electron-builder --win nsis --x64",
    "release:archive": "node scripts/archive-github-release.cjs",
    "release:archive:dry": "node scripts/archive-github-release.cjs --dry-run --allow-dirty",
    "dist:mac": "npm run icon:build && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --arm64",
    "pack:win": "npm run icon:build && npm run build && electron-builder --win --dir",
    "pack:mac": "npm run icon:build && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "cloud:install": "npm install --prefix cloud",
    "cloud:migrate": "npm run migrate --prefix cloud",
    "cloud:start": "npm run start --prefix cloud",
    "start": "node electron/run-electron.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.gihostings.giposrestaurant",
    "productName": "GI POS Restaurant",
    "copyright": "Copyright (c) 2026 GI Hostings",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://goldensea.gihostings.in/updates/win"
      }
    ],
    "win": {
      "icon": "public/app_icon.ico",
      "legalTrademarks": "GI Hostings",
      "signtoolOptions": {
        "publisherName": "GI Hostings"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "public/app_icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName} ${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName} ${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/app_icon.ico",
      "uninstallerIcon": "public/app_icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "public/app_icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GI POS Restaurant",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  }
}
