        <item name="colorPrimary">@color/gi_red</item>
        <item name="colorPrimaryVariant">@color/gi_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gi_teal</item>
        <item name="colorSecondaryVariant">@color/gi_teal</item>
        <item name="colorOnSecondary">@color/white</item>
